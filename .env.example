# Copia este archivo como .env y completa los valores antes de levantar docker compose

# Base de datos
DB_USERNAME=sistemas
DB_PASSWORD=
DB_DATABASE=fevrips_db
DB_PORT=5432
DB_DIALECT=postgres

# Backend
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=
JWT_EXPIRATION=8h

# CORS — IPs o dominios desde donde el navegador accede al servidor
CORS_ORIGINS=http://172.16.4.7,http://localhost

# API externa CUV (fevrips-api) — usar el nombre del contenedor en la red
# Docker interna (app_fevrips-net), no la IP del host, para evitar depender
# de ufw/firewall/router en llamadas que nunca deberían salir del servidor.
CUV_API_URL=https://fevrips-api:5100
CUV_API_TIMEOUT=30000
NODE_TLS_REJECT_UNAUTHORIZED=0

# Frontend (dejar vacío en producción — nginx hace el proxy)
VITE_API_URL=

# HTTPS — carpeta en el host (fuera del repo) con cert.crt y cert.key
SSL_CERTS_PATH=/opt/certs
