# Base de datos PostgreSQL
DB_USERNAME=sistemas
DB_PASSWORD=
DB_DATABASE=fevrips_db
DB_PORT=5432
DB_DIALECT=postgres

# Backend
PORT=3000
NODE_ENV=production
JWT_SECRET=
JWT_EXPIRATION=8h

# CORS — IPs o dominios desde donde el navegador accede al servidor
CORS_ORIGINS=http://172.16.4.7,http://localhost

# API externa CUV
CUV_API_URL=https://172.16.4.7:9443
CUV_API_TIMEOUT=30000
NODE_TLS_REJECT_UNAUTHORIZED=0

# Frontend (dejar vacío en producción — nginx hace el proxy)
VITE_API_URL=
